[Unit]
Description=Yaklog output-strand ingester (${INSTANCE_NAME})
After=network-online.target docker.service
Wants=docker.service

[Service]
Type=oneshot

User=${OPS_USER}
Group=${OPS_USER}

Environment=YAKLOG_OPS_KEY_FILE=${OPS_KEY_PATH}
Environment=TEXTFILE_DIR=${TEXTFILE_DIR}

ExecStart=${INGESTER_SCRIPT} \
  --yaklog-url http://127.0.0.1:${DASHBOARD_PORT} \
  --ops-key-file ${OPS_KEY_PATH}

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=${TEXTFILE_DIR}
PrivateTmp=true

StandardOutput=journal
StandardError=journal

# EnvironmentFile for yaklog-audit-rollup.service.
# Install path: /etc/plexus/yaklog-audit-rollup.env (mode 0600, owner
# plexus-audit-rollup:plexus-audit-rollup).
#
# Per feedback_secrets_no_yaklog: the ops-key itself MUST live in its own
# mode-600 file referenced via PLEXUS_OPS_KEY_FILE; NEVER inlined here.
# This env file only carries the PATH to the ops-key file + the DAYS_BACK
# tunable.
#
# Per ssw-devops #10857 sister-shape canon: per-service scoped ops-key
# (NOT shared with output-ingester / wal-checkpoint / audit-anchor-publisher).
# Operator mints distinct ops-key value owned by plexus-audit-rollup user.

# Path to ops-key file (mode 0600, owner plexus-audit-rollup:
# plexus-audit-rollup). The script reads this file and uses its contents as
# a Bearer token for POST /api/v1/ops/audit-rollup/backfill.
PLEXUS_OPS_KEY_FILE=/etc/plexus/audit-rollup-ops-key

# Days-back window per cron firing. Default 7 for steady-state incremental
# rollup (idempotent UPSERT covers any gaps in last week). Operator can
# bump to 90 for first-deploy backfill (one-shot adjustment, then revert
# to 7) — or use the ops endpoint directly with custom days_back per
# PLAN §13 option (d) operator-trigger pattern.
DAYS_BACK=7

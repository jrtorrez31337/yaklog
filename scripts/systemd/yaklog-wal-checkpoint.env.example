# yaklog-wal-checkpoint EnvironmentFile template
# Copy to /etc/plexus/yaklog-wal-checkpoint.env (mode 0640, owned by
# plexus-wal-checkpoint:plexus-wal-checkpoint) and edit values.

# Path to ops-key file (mode-600, owned by plexus-wal-checkpoint service user).
# Sister-shape to yaklog-output-ingester.env PLEXUS_OPS_KEY_FILE pattern.
# Per feedback_secrets_no_yaklog: NEVER inline; file-only transit.
PLEXUS_OPS_KEY_FILE=/etc/plexus/yaklog-wal-checkpoint.ops-key

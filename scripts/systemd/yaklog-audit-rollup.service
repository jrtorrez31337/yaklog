# yaklog-audit-rollup service — CP16 Phase 2 cron-driven audit-aggregate
# rollup driver per PLAN-CP16-PILLAR-AUDIT-ROLLUP-SUBSTRATE.md §13
# option (b)+(d) + ssw-devops install canon #10857.
#
# Pattern: sister-shape yaklog-output-ingester.service hardening shape +
# audit-anchor-publisher canon. Reads ops-key path from EnvironmentFile
# per feedback_secrets_no_yaklog discipline (NEVER argv; file-only transit).
#
# Per-host install (admin or ssw-devops coord):
#   0. install -m 0755 -o root -g root scripts/yaklog-audit-rollup.sh \
#      /usr/local/bin/yaklog-audit-rollup.sh
#      (REQUIRED — ProtectHome=true makes /home/* unreachable; see secops
#      review-pair canon at handoff #9768)
#   1. cp scripts/systemd/yaklog-audit-rollup.service /etc/systemd/system/
#   2. cp scripts/systemd/yaklog-audit-rollup.timer   /etc/systemd/system/
#   3. cp scripts/systemd/yaklog-audit-rollup.env.example /etc/yaklog/yaklog-audit-rollup.env
#      + edit to set YAKLOG_OPS_KEY_FILE path
#   4. install -d -m 0755 -o yaklog-audit-rollup -g yaklog-audit-rollup \
#      /var/lib/yaklog/textfile/audit-rollup
#   5. systemctl daemon-reload
#   6. systemctl enable --now yaklog-audit-rollup.timer

[Unit]
Description=Yaklog CP16 audit-aggregate rollup driver
After=network-online.target docker.service
Wants=docker.service

[Service]
Type=oneshot

# Dedicated unprivileged runner per secops least-privilege canon.
# Operator creates with:
#   useradd --system --no-create-home --shell /usr/sbin/nologin yaklog-audit-rollup
User=yaklog-audit-rollup
Group=yaklog-audit-rollup

# EnvironmentFile provides YAKLOG_OPS_KEY_FILE path (mode-600 owned by
# this service user); never argv per feedback_secrets_no_yaklog.
EnvironmentFile=/etc/yaklog/yaklog-audit-rollup.env

# Prom textfile collector sub-directory. Sister-shape to existing
# /var/lib/yaklog/textfile/ canonical tree (output-ingester / wal-checkpoint
# / audit-anchor-publisher each use their own sub-dir; node_exporter scrape
# glob covers the textfile/ tree).
Environment=TEXTFILE_DIR=/var/lib/yaklog/textfile/audit-rollup

# Defaults to 7-day window per incremental rollup canon; can be overridden via
# /etc/yaklog/yaklog-audit-rollup.env DAYS_BACK= (e.g. 90 for full backfill
# at deploy time per PLAN §13 option (a)/(d) bridge use case).
Environment=DAYS_BACK=7

# ExecStart path canonical at /usr/local/bin/ per secops #9768 blocking-gate:
# ProtectHome=true below makes /home/* unreachable to the service namespace,
# so the script MUST live under /usr/local/bin/. Operator copies as part of
# install sequence (mode 0755 root:root).
ExecStart=/usr/local/bin/yaklog-audit-rollup.sh \
  --yaklog-url http://localhost:3100 \
  --ops-key-file ${YAKLOG_OPS_KEY_FILE} \
  --days-back ${DAYS_BACK}

# Hardening (mirror yaklog-audit-ingester + audit-anchor-publisher pattern)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yaklog/textfile/audit-rollup
PrivateTmp=true

# Single-shot per timer firing
StandardOutput=journal
StandardError=journal

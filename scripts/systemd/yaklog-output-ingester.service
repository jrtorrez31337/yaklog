# yaklog-output-ingester service — CP13 / ADR-0032 Phase 1.2 cron-driven
# output-strand ingester. Hourly cadence per ADR-0032 §2.3.
#
# Pattern: mirrors audit-anchor-publisher.service hardening shape.
# Reads ops-key path from EnvironmentFile per feedback_secrets_no_yaklog
# discipline (NEVER argv; file-only transit).
#
# Per-host install (admin or ssw-devops coord):
#   0. install -m 0755 -o root -g root scripts/yaklog-output-ingester.sh \
#      /usr/local/bin/yaklog-output-ingester.sh
#      (REQUIRED — ProtectHome=true makes /home/* unreachable; see secops
#      review-pair canon at handoff #9768)
#   1. cp scripts/systemd/yaklog-output-ingester.service /etc/systemd/system/
#   2. cp scripts/systemd/yaklog-output-ingester.timer   /etc/systemd/system/
#   3. cp scripts/systemd/yaklog-output-ingester.env.example /etc/plexus/yaklog-output-ingester.env
#      + edit to set PLEXUS_OPS_KEY_FILE path
#   4. install -d -m 0755 -o plexus-output-ingester -g plexus-output-ingester \
#      /var/lib/yaklog/textfile/output-ingester
#   5. systemctl daemon-reload
#   6. systemctl enable --now yaklog-output-ingester.timer

[Unit]
Description=Plexus CP13/ADR-0032 output-strand ingester
After=network-online.target docker.service
Wants=docker.service

[Service]
Type=oneshot

# Dedicated unprivileged runner per secops least-privilege canon.
# Operator creates with:
#   useradd --system --no-create-home --shell /usr/sbin/nologin plexus-output-ingester
User=plexus-output-ingester
Group=plexus-output-ingester

# EnvironmentFile provides PLEXUS_OPS_KEY_FILE path (mode-600 owned by
# this service user); never argv per feedback_secrets_no_yaklog.
EnvironmentFile=/etc/plexus/yaklog-output-ingester.env

# Prom textfile collector sub-directory. Sister-shape to existing
# /var/lib/yaklog/textfile/ (owned by plexus-audit-publisher per ssw-devops
# #9769 pre-condition empirical) — output-ingester uses its own sub-dir to
# preserve audit-publisher canonical ownership. node_exporter scrape glob
# covers the textfile/ tree.
Environment=TEXTFILE_DIR=/var/lib/yaklog/textfile/output-ingester

# ExecStart path canonical at /usr/local/bin/ per secops #9768 blocking-gate:
# ProtectHome=true below makes /home/* unreachable to the service namespace,
# so the script MUST live under /usr/local/bin/. Operator copies as part of
# install sequence (mode 0755 root:root).
ExecStart=/usr/local/bin/yaklog-output-ingester.sh \
  --yaklog-url http://localhost:3100 \
  --ops-key-file ${PLEXUS_OPS_KEY_FILE}

# Hardening (mirror plexus-audit-ingester + audit-anchor-publisher pattern)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yaklog/textfile/output-ingester
PrivateTmp=true

# Single-shot per timer firing
StandardOutput=journal
StandardError=journal

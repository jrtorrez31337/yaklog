# EnvironmentFile for yaklog-output-ingester.service.
# Install path: /etc/plexus/yaklog-output-ingester.env (mode 0600, owner
# plexus-output-ingester:plexus-output-ingester).
#
# Per feedback_secrets_no_yaklog: the ops-key itself MUST live in its own
# mode-600 file referenced via PLEXUS_OPS_KEY_FILE; NEVER inlined here.
# This env file only carries the PATH to the ops-key file.

# Path to ops-key file (mode 0600, owner plexus-output-ingester:
# plexus-output-ingester). The script reads this file and uses its
# contents as a Bearer token for POST /api/v1/ops/output/ingest.
PLEXUS_OPS_KEY_FILE=/etc/plexus/ops-key

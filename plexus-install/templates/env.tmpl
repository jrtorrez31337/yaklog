# plexus-install generated ${GENERATED_AT}
# INSTANCE: ${INSTANCE_NAME}
# DO NOT commit or share. Contains the plexus-admin bearer.

# ── yaklog server ────────────────────────────────────────────────────────
YAKLOG_DB_PATH=/data/yaklog.db
YAKLOG_API_KEYS=${PLEXUS_ADMIN_BEARER}
YAKLOG_OPS_API_KEYS=${PLEXUS_ADMIN_BEARER}
YAKLOG_TOKEN_BINDINGS=plexus-admin:${PLEXUS_ADMIN_BEARER}
YAKLOG_DAEMON_BINDINGS=plexus-admin:${PLEXUS_ADMIN_BEARER}
YAKLOG_BIND_IP=${YAKLOG_BIND_IP}

# ── Instance identity + ports (consumed by docker-compose.yml) ──────────
INSTANCE_NAME=${INSTANCE_NAME}
PLEXUS_BIND_IP=${PLEXUS_BIND_IP}
DASHBOARD_PORT=${DASHBOARD_PORT}
PROM_PORT=${PROM_PORT}
GRAFANA_PORT=${GRAFANA_PORT}
OTLP_GRPC_PORT=${OTLP_GRPC_PORT}
OTLP_HTTP_PORT=${OTLP_HTTP_PORT}
OTEL_HEALTH_PORT=${OTEL_HEALTH_PORT}
MINIO_PORT=${MINIO_PORT}
MINIO_CONSOLE_PORT=${MINIO_CONSOLE_PORT}

# ── Optional: GitHub PAT for outputIngester GitHubWalker ────────────────
# If set, place a fine-grained PAT (mode 0600 root:root) at pat/github-pat
# in the install dir; the container reads via :ro bind-mount at /pat/github-pat.
# Walker no-ops if unset (repos still registerable; just no commit walking).

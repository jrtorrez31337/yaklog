        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Yaklog-Prometheus" },
          "expr": "sum by (yaklog_agent_id) (claude_code_cost_usage_USD_total)",
          "legendFormat": "{{yaklog_agent_id}}",
          "refId": "A"
        }
      ],
      "title": "Cumulative USD cost — per agent",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Yaklog-Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },

      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Yaklog-Prometheus" },
          "expr": "sum by (yaklog_agent_id, model, type) (rate(claude_code_token_usage_tokens_total[5m]))",
          "legendFormat": "{{yaklog_agent_id}} · {{model}} · {{type}}",
          "refId": "A"
        }
      ],
      "title": "Token usage (rate over 5m) — per agent · model · type",

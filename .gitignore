# Per-agent Claude Code workspace state (hook settings + worktrees).
# yaklog-the-server is one consumer of this repo; agent-runtime state
# belongs in the agent's home dir, not in the public repo.
.claude/

# Yaklog OTel stack runtime data (Prom WAL + Grafana sqlite). Stage 1
# uses docker named volumes (yaklog_prom_data, yaklog_grafana_data), so
# this is belt-and-suspenders in case the stack is ever reconfigured to
# bind-mount.
otel/data/
otel/grafana/data/

# Internal/agent-lane docs do NOT live in this repo.
# yaklog-dev's ADR input artifacts, internal design docs, and lane-specific
# specs belong in ~/agents/yaklog-dev/specs/ (pushed to bare-git on the yaklog host,
# never to the public github remote). Anything in docs/ here MUST be
# operator/user-facing public documentation.
docs/adr/
docs/plans/2026-04-27-direct-messages-design.md
docs/plans/*-design.md

# Docker compose safety captures (taken before infra changes).
docker-compose.yml.bak*

# Yaklog secrets (CP4 rotation). Per-host env_files MUST stay out of repo.
*yaklog-grafana.env
*yaklog-*.env
dist/
